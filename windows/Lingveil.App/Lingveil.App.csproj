<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Lingveil</AssemblyName>
    <RootNamespace>Lingveil.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Lingveil.App.Program</StartupObject>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lingveil.Core\Lingveil.Core.csproj" />
  </ItemGroup>

  <!-- Both apps read the same catalog and language list; they are copied, not duplicated. -->
  <ItemGroup>
    <None Include="..\..\shared\models.json" Link="shared\models.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\shared\languages.json" Link="shared\languages.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
