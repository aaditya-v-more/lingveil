{
  "about": "Local translation models offered in Settings > Models. Order is display order: recommended (tested) first. Ratings 1-5; 0 = not rated yet. See bench/BENCHMARKS.md.",
  "languageSets": {
    "hy-mt": [
      "zh-CN",
      "en",
      "fr",
      "pt",
      "es",
      "ja",
      "tr",
      "ru",
      "ar",
      "ko",
      "th",
      "it",
      "de",
      "vi",
      "ms",
      "id",
      "tl",
      "hi",
      "zh-TW",
      "pl",
      "cs",
      "nl",
      "fa",
      "gu",
      "ur",
      "te",
      "mr",
      "iw",
      "bn",
      "ta",
      "uk"
    ]
  },
  "prompts": {
    "hy-mt": {
      "endpoint": "chat",
      "template": "Translate the following text into {target}. Note that you should only output the translated result without any additional explanation:\n\n{text}",
      "params": {
        "temperature": 0.2,
        "top_p": 0.6,
        "top_k": 20,
        "repeat_penalty": 1.05
      },
      "serverArgs": [
        "--jinja"
      ]
    },
    "index-translate": {
      "endpoint": "chat",
      "template": "请将以下文本翻译为{targetChinese}，直接输出翻译结果，不要进行任何解释。\n\n{text}",
      "params": {
        "temperature": 0
      },
      "serverArgs": [
        "--jinja"
      ]
    },
    "gemma": {
      "endpoint": "chat",
      "template": "Translate the following text into {target}. Reply with only the translation, nothing else.\n\n{text}",
      "params": {
        "temperature": 0
      },
      "serverArgs": [
        "--jinja"
      ]
    },
    "translate-gemma": {
      "endpoint": "completion",
      "template": "<start_of_turn>user\nYou are a professional {source} ({sourceCode}) to {target} ({targetCode}) translator. Your goal is to accurately convey the meaning and nuances of the original {source} text while adhering to {target} grammar, vocabulary, and cultural sensitivities.\nProduce only the {target} translation, without any additional explanations or commentary. Please translate the following {source} text into {target}:\n\n\n{text}<end_of_turn>\n<start_of_turn>model\n",
      "params": {
        "temperature": 0
      },
      "serverArgs": [
        "--no-jinja",
        "--chat-template",
        "gemma"
      ]
    }
  },
  "server": {
    "args": [
      "-c",
      "8192",
      "-np",
      "4",
      "-ngl",
      "99",
      "-fa",
      "on",
      "-b",
      "512",
      "-ub",
      "256",
      "--no-webui",
      "--log-disable"
    ],
    "parallel": 4,
    "idleStopSeconds": 180,
    "maxTokens": "min(1024, 4 * characters + 48)",
    "chatExtra": {
      "chat_template_kwargs": {
        "enable_thinking": false
      },
      "cache_prompt": true
    }
  },
